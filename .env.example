# =====================================================================
# Project Aegis — Modelo de variáveis de ambiente
# Copie para `.env` (NUNCA versionar o .env real) e preencha.
#   cp .env.example .env
# =====================================================================

# --- Provedor Cognitivo (OpenAI-compatível) ---------------------------
# Exemplos de endpoints compatíveis com Function Calling nativo:
#   DeepSeek : https://api.deepseek.com/v1        (modelo: deepseek-chat)
#   OpenRouter: https://openrouter.ai/api/v1       (modelo: deepseek/deepseek-chat-v3)
#   NVIDIA NIM: https://integrate.api.nvidia.com/v1
OPENAI_API_BASE=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-REPLACE_ME
MODEL_NAME=deepseek-chat

# Parâmetros de inferência
AEGIS_TEMPERATURA=0.7
AEGIS_MAX_TOKENS=4096
AEGIS_TIMEOUT=60

# --- Sessão / persistência --------------------------------------------
# thread_id controla o tópico/conversa (checkpoints retomáveis no SQLite)
AEGIS_THREAD_ID=default
AEGIS_DB=memoria_agente.db          # banco de checkpoints + store de longo prazo

# --- Gestão de contexto (janela) --------------------------------------
AEGIS_LIMIAR_COMPRESSAO=20          # nº de mensagens antes de comprimir histórico
AEGIS_MANTER_APOS_COMPRESSAO=8      # mensagens recentes mantidas após comprimir
AEGIS_MAX_TENTATIVAS_CORRECAO=3     # limite do loop de auto-correção

# --- Memória de longo prazo (Store) -----------------------------------
AEGIS_MEMORIA_ATIVA=true            # extrai fatos duráveis do perfil do usuário

# --- Habilidades auto-evolutivas (padrão agentskills.io) ---------------
AEGIS_SKILLS_DIR=.skills

# --- Trajetória de auditoria (JSONL, base p/ ShareGPT/RL) --------------
AEGIS_TRAJETORIA=false               # true para habilitar o trajectory logging
AEGIS_TRAJETORIA_DIR=trajetorias/    # pasta onde os JSONL são gravados

# --- Subagentes avançados (agent-as-tool) ------------------------------
AEGIS_SUBAGENTES=true               # habilita pesquisador/redator (delegação)

# --- Cron interno (agendador) ------------------------------------------
# AEGIS_AGENDAMENTOS=agendamentos.jsonl     # arquivo de persistência
# AEGIS_AGENDADOR_INTERVALO=60             # segundos entre execuções do daemon
# AEGIS_AGENDADOR_CALLBACK_URL=https://... # webhook notificado a cada conclusão

# --- Gateway Webhook HTTP (opcional) ------------------------------------
AEGIS_GATEWAY_PORT=8787              # porta do servidor HTTP (pixi run gateway)

# --- Busca web alterna via SearXNG (opcional) --------------------------
# Se definido, a ferramenta buscar_web usa a API JSON do SearXNG
# em vez do DuckDuckGo. Ex.: http://localhost:8888
AEGIS_SEARXNG_URL=

# --- Dev / verbose -----------------------------------------------------
AEGIS_DEV=false